# ============================================================
# KIS API 설정
# ============================================================
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_ACCOUNT=your_account_number_here
KIS_VIRTUAL=True

# ============================================================
# 텔레그램 설정
# ============================================================
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ============================================================
# 멀티팩터 전략 파라미터
# ============================================================
# 팩터 가중치 (합계 1.0)
FACTOR_WEIGHT_MOMENTUM=0.40
FACTOR_WEIGHT_VALUE=0.20
FACTOR_WEIGHT_QUALITY=0.20
FACTOR_WEIGHT_VOLATILITY=0.20

# 팩터 계산 파라미터
MOMENTUM_PERIOD=126
VOLATILITY_PERIOD=252

# 종목 선정
TOP_N_STOCKS=15
MIN_COMPOSITE_SCORE=-0.5

# ============================================================
# 리밸런싱 설정
# ============================================================
REBALANCE_PERIOD_DAYS=30
REBALANCE_HOUR=10

# ============================================================
# 리스크 관리
# ============================================================
STOP_LOSS_ENABLED=True
STOP_LOSS_PERCENT=-15.0
TRAILING_STOP_ENABLED=True
TRAILING_STOP_PERCENT=-15.0
MIN_HOLD_DAYS=7
MAX_HOLD_DAYS=90

# ============================================================
# 포지션 관리
# ============================================================
MAX_POSITIONS=20
MIN_ORDER_AMOUNT_USD=2000
MAX_ORDER_AMOUNT_USD=10000
POSITION_SIZE_METHOD=equal

# ============================================================
# 봇 운영 설정
# ============================================================
SCAN_INTERVAL=3600
# 스캔 분 (매시 01분, 31분)
SCAN_MINUTES=1,31
# 세션 판정 시간대 (미국 동부, 서머타임 자동) / 로그·알림 표시 시간대
MARKET_TIMEZONE=America/New_York
DISPLAY_TIMEZONE=Asia/Seoul
# 세션 시간 (ET). 기본값: 데이마켓 20:00~03:50, 프리 04:00~09:30, 정규 09:30~16:00, 애프터 16:00~19:50
# DAY_MARKET_START=20:00
# DAY_MARKET_END=03:50
DRY_RUN=True

# ============================================================
# 동적 스크리닝 설정
# ============================================================
DYNAMIC_SCREENING_ENABLED=True
DYNAMIC_SCREENING_MIN_MARKET_CAP=500000000
DYNAMIC_SCREENING_MIN_PRICE=5.0
DYNAMIC_SCREENING_MIN_VOLUME=50000
DYNAMIC_SCREENING_MAX_TICKERS=200
DYNAMIC_SCREENING_WORKERS=10
# 유니버스 섹터 제한 (GICS 섹터명, 쉼표 구분, 빈 값=전 섹터). 실봇·백테스트 공통
# 예: Information Technology, Communication Services, Consumer Discretionary
UNIVERSE_SECTORS=Information Technology

# ============================================================
# 백테스팅 설정
# ============================================================
BACKTEST_START_DATE=2020-01-01
BACKTEST_END_DATE=2025-11-20
BACKTEST_INITIAL_CAPITAL=100000
BACKTEST_COMMISSION=0.001

# ============================================================
# Database 설정 (PostgreSQL)
# ============================================================
DB_ENABLED=False
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_bot
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# 또는 전체 URL로 설정 (위 설정보다 우선)
# DATABASE_URL=postgresql://user:password@localhost:5432/trading_bot

# ============================================================
# Paper Trading 설정
# ============================================================
PAPER_TRADING_ENABLED=False
PAPER_TRADING_INITIAL_CAPITAL=100000
PAPER_ACCOUNT_ID=1

# ============================================================
# Live Trading 설정
# ============================================================
LIVE_TRADING_ENABLED=False
LIVE_ACCOUNT_ID=2
# KIS 현금과 DB 현금 차이가 이 값(USD)을 넘으면 입출금으로 간주해 initial_capital 에 반영
LIVE_CASH_FLOW_THRESHOLD_USD=100
LIVE_SYNC_INTERVAL=300
